# Copy to project root as `.env.tls` (or pass `--env-file`) for docker-compose.tls.yml

# Public hostname that resolves to this server (Cloudflare proxy may be ON; DNS-01 still works).
TLS_DOMAIN=logs.example.com

# Let's Encrypt registration email
ACME_EMAIL=you@example.com

# Cloudflare API token with Zone:DNS:Edit on the zone that contains TLS_DOMAIN
# https://dash.cloudflare.com/profile/api-tokens
CF_DNS_API_TOKEN=

# Strong secret for PHP sessions (override defaults)
RSYSLOG_SESSION_SECRET=generate-a-long-random-string
RSYSLOG_ADMIN_USERNAME=admin
RSYSLOG_ADMIN_PASSWORD=change-me
