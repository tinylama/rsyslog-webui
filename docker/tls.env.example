# Copy to project root as `.env.tls` (or pass `--env-file`) for:
# - Recommended: `docker compose --env-file .env.tls up -d --build` (main `docker-compose.yml` + Traefik)
# - Same vars work with `docker-compose.tls.yml` or `docker-compose.tls-manual.yml` if you prefer those files
#
# This file sets COMPOSE_PROFILES=tls so you do not need `--profile tls` on the command line.
# For local HTTP-only dev, do not pass this file — use plain `docker compose up` (see README).

# Public hostname that resolves to this server (Cloudflare proxy may be ON; DNS-01 still works).
TLS_DOMAIN=logs.example.com

# Let's Encrypt registration email
ACME_EMAIL=you@example.com

# Enables Traefik on host 80/443 when using `docker-compose.yml` (Docker Compose reads this from --env-file).
COMPOSE_PROFILES=tls

# Cloudflare API token with Zone:DNS:Edit on the zone that contains TLS_DOMAIN.
# Required for ACME on `docker-compose.yml` (TLS profile) and `docker-compose.tls.yml`.
# https://dash.cloudflare.com/profile/api-tokens
CF_DNS_API_TOKEN=

# Manual cert mode (docker-compose.tls-manual.yml):
# Put your files at:
#   docker/certs/tls.crt
#   docker/certs/tls.key

# Strong secret for PHP sessions (override defaults)
RSYSLOG_SESSION_SECRET=generate-a-long-random-string
RSYSLOG_ADMIN_USERNAME=admin
RSYSLOG_ADMIN_PASSWORD=change-me
